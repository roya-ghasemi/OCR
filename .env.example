# Persian OCR service settings. Copy to .env and change what you need; every line is
# optional and shows the default. Environment variables override this file.
# Docker compose reads the same file (deploy/docker-compose.yml).

# --- paths ----------------------------------------------------------------------------
# Relative paths are relative to this project folder. The only program outside it is
# Tesseract itself; empty finds it in Program Files or on PATH.
OCRS_TESSERACT_CMD=
OCRS_TESSDATA_DIR=models/tesseract
OCRS_DIGIT_MODEL=models/digit_cnn.npz
OCRS_CACHE_DIR=.cache/ocr
# Persian model: fas_custom (fine-tuned, default) or fas (stock). Arabic re-read: ara, or empty to disable.
OCRS_LANG_FA=fas_custom
OCRS_LANG_AR=ara

# --- recognition ----------------------------------------------------------------------
OCRS_LAYOUT_PSMS=3,4,6
OCRS_TEXT_PSMS=11
OCRS_CROP_PAGE=1
OCRS_INK_SEPARATE=1
OCRS_DESKEW_MIN_DEG=1.0
OCRS_MIN_LINE_CONF=30
OCRS_NUMBER_MIN_PROB=0.6
OCRS_LETTER_FIELDS=1
OCRS_SPELLFIX=1

# --- capacity ---------------------------------------------------------------------------
# Tesseract processes per page, and pages read at once per API process. Keep
# uvicorn workers x pages x processes near the number of CPU cores.
OCRS_WORKERS=8
OCRS_MAX_CONCURRENT_PAGES=2
OCRS_MAX_UPLOAD_MB=25

# --- cache ------------------------------------------------------------------------------
OCRS_CACHE=1
OCRS_CACHE_MAX_ENTRIES=2000

# --- access -----------------------------------------------------------------------------
# When set, POST /ocr and GET /jobs require the header X-API-Key with this value.
OCRS_API_KEY=

# --- queue (OCRS_ASYNC_MODE=1) ----------------------------------------------------------
OCRS_ASYNC_MODE=0
OCRS_REDIS_URL=redis://127.0.0.1:6379/0
OCRS_SPOOL_DIR=
OCRS_JOB_TTL_S=86400
OCRS_REQUEST_TIMEOUT_S=600

OCRS_LOG_LEVEL=INFO
